<Application x:Class="StremioXboxPrototype.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BackgroundPrimary">#090C1D</Color><Color x:Key="Surface">#12183A</Color><Color x:Key="SurfaceHover">#20235A</Color><Color x:Key="SurfaceBorder">#2C3569</Color><Color x:Key="AccentPurple">#5B3DF5</Color><Color x:Key="FocusBorder">#9D8CFF</Color><Color x:Key="TextPrimary">#F7F7FF</Color><Color x:Key="TextSecondary">#BCBCE8</Color><Color x:Key="TextMuted">#8286B5</Color><Color x:Key="Success">#4EE087</Color>
      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundPrimary}"/><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/><SolidColorBrush x:Key="SurfaceFocusBrush" Color="{StaticResource SurfaceHover}"/><SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorder}"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPurple}"/>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
      <Style TargetType="FontIcon"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="20"/><Setter Property="Margin" Value="0,0,15,0"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/></Style>
      <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
      <Style x:Key="NavCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="10,0,0,8"/></Style>
      <Style x:Key="GamepadChip" TargetType="Border"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderThickness" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
      <Style x:Key="FocusButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/></Border><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceFocusBrush}"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard></VisualState></VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/></Storyboard></VisualState><VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.12"/><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush"><DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource FocusBorderBrush}"/></ObjectAnimationUsingKeyFrames><ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderThickness"><DiscreteObjectKeyFrame KeyTime="0" Value="2"/></ObjectAnimationUsingKeyFrames></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FocusButton}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="14,13"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="16"/></Style>
      <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource FocusButton}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="14"/></Style>
      <Style x:Key="SearchBox" TargetType="TextBox"><Setter Property="Background" Value="#171C42"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="#3A4380"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="21,9"/><Setter Property="FontSize" Value="16"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
