<Application x:Class="StremioXboxPrototype.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BackgroundPrimary">#080A18</Color>
      <Color x:Key="SidebarBackground">#0A0D1F</Color>
      <Color x:Key="SidebarBorder">#1A1F3D</Color>
      <Color x:Key="Surface">#131735</Color>
      <Color x:Key="SurfaceHover">#1C214A</Color>
      <Color x:Key="SurfaceBorder">#21274F</Color>
      <Color x:Key="AccentPurple">#5148F6</Color>
      <Color x:Key="FocusBorder">#4F6BFF</Color>
      <Color x:Key="TextPrimary">#FFFFFF</Color>
      <Color x:Key="TextSecondary">#8E95B8</Color>
      <Color x:Key="TextMuted">#656C8F</Color>
      <Color x:Key="Success">#4EE087</Color>
      <Color x:Key="AlertBackground">#251120</Color>
      <Color x:Key="AlertBorder">#48182B</Color>
      <Color x:Key="AlertText">#D67088</Color>
      <Color x:Key="AlertIcon">#E04060</Color>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundPrimary}"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarBackground}"/>
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorder}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
      <SolidColorBrush x:Key="SurfaceFocusBrush" Color="{StaticResource SurfaceHover}"/>
      <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorder}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPurple}"/>
      <SolidColorBrush x:Key="AlertBackgroundBrush" Color="{StaticResource AlertBackground}"/>
      <SolidColorBrush x:Key="AlertBorderBrush" Color="{StaticResource AlertBorder}"/>
      <SolidColorBrush x:Key="AlertTextBrush" Color="{StaticResource AlertText}"/>
      <SolidColorBrush x:Key="AlertIconBrush" Color="{StaticResource AlertIcon}"/>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      </Style>
      <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      </Style>

      <Style x:Key="FocusButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
              </Border>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="PointerOver">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceFocusBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed"/>
                  <VisualState x:Name="Disabled">
                    <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Unfocused">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Focused">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.12"/>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource FocusBorderBrush}"/>
                      </ObjectAnimationUsingKeyFrames>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderThickness">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="2.5"/>
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FocusButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
      </Style>

      <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource FocusButton}">
        <Setter Property="Background" Value="#15193B"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#242A58"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
      </Style>

      <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource FocusButton}">
        <Setter Property="Background" Value="#1B192A"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#3B3552"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="#121634"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#232954"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="FontSize" Value="14"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
